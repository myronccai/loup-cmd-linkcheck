@mode(host.dual)

# linkcheck's side of HTTP/1.1: the request it sends and the reading of the
# reply, built on net.http's types (Request, Headers, HttpStatus,
# HttpVersion). net.http itself is a server; the client is these functions
# over net.tcp (lib/fetch.lpscr).
#
# Runtime: host.dual, but only ever interpreted here, by Stage0:
# lib/fetch.lpscr and lib/crawler.lpscr import it under
# `loup-bootstrap run --allow-net`, and tests/httpwire_test.lpscr under
# `loup-bootstrap test`. Nothing in this project compiles it.
#
# Structure: HttpReply; make_request() and request_text() for the way out;
# then the reply, bottom up: header_end(), parse_status_line(),
# parse_headers(), dechunk() and parse_reply(), which puts them together.
# Replies are read as bytes, because chunk sizes and Content-Length count
# bytes; the body is decoded as UTF-8 at the end.

from net.http import (Headers, HttpStatus, HttpVersion, Request);
from net.addressing import (Url, defaultPort);
from .urls import (host_text);

## A reply as linkcheck uses it: the status, the header fields and the body
## as text.
pub class HttpReply {
    pub let status: HttpStatus;
    pub let headers: Headers;
    pub let body: string;

    pub func constructor(status: HttpStatus, headers: Headers, body: string) {
        this.status = status;
        this.headers = headers;
        this.body = body;
    }

    pub func header(name: string): Option[string] {
        return this.headers.get(name);
    }

    ## The media type: Content-Type without its parameters, lower-cased
    ## ("" when there is none).
    pub func media_type(): string {
        let value = this.header("Content-Type") ?? "";
        let semi = value.index_of(";");
        let bare = if (semi >= 0) { value.slice(0, semi) } else { value };
        return bare.trim().toLowerCase();
    }

    ## Whether the body is a page to read for links.
    pub func is_html(): bool {
        let media = this.media_type();
        return media == "text/html" or media == "application/xhtml+xml";
    }

    pub func location(): Option[string] {
        return this.header("Location");
    }
}

## The request for `method` and `url`: HTTP/1.1, one request per connection
## (`Connection: close`), so the reply ends where the connection does.
pub func make_request(method: string, url: Url, agent: string): Request {
    var target = if (url.path.len() == 0) { "/" } else { url.path };
    match url.query {
        Some(q) => { target += "?" + q; },
        None => {},
    }
    let port = url.effectivePort();
    let host = if (port == defaultPort(url.scheme)) { host_text(url) } else { i"{$ host_text(url) $}:{$ port $}" };
    let headers = Headers.fromPairs([
        ("Host", host),
        ("User-Agent", agent),
        ("Accept", "*/*"),
        ("Connection", "close"),
    ]);
    return Request(method, target, HttpVersion.HTTP_1_1, headers, "");
}

## The request on the wire: the request line, one line per header field,
## and the blank line that ends them (the requests have no body).
pub func request_text(req: Request): string {
    var lines: list[string] = [i"{$ req.method $} {$ req.target $} {$ req.version.toString() $}"];
    for (field in req.headers.items()) {
        lines.push(field.0 + ": " + field.1);
    }
    return lines.join("\r\n") + "\r\n\r\n";
}

## Where the header block of a raw reply ends: the index just past its
## blank line (CR LF CR LF, or LF LF from a careless server), or -1.
pub func header_end(raw: bytes): int {
    for (k in 0..raw.len()) {
        if (raw[k] != 10) {
            continue;
        }
        if (k + 1 < raw.len() and raw[k + 1] == 10) {
            return k + 2;
        }
        if (k + 2 < raw.len() and raw[k + 1] == 13 and raw[k + 2] == 10) {
            return k + 3;
        }
    }
    return -1;
}

## `HTTP/1.1 404 Not Found` as (404, "Not Found").
pub func parse_status_line(line: string): Result[(int, string), string] {
    if (!line.startsWith("HTTP/")) {
        return Err("not an HTTP reply");
    }
    let parts = line.split(" ");
    if (parts.len() < 2 or parts[1].len() != 3) {
        return Err("malformed status line");
    }
    for (ch in parts[1]) {
        if (ch < "0" or ch > "9") {
            return Err("malformed status line");
        }
    }
    let reason = parts.slice(2).join(" ").trim();
    return Ok((parts[1].toInt(), reason));
}

## The header fields of the lines after the status line; a line without a
## colon is skipped, a repeated name keeps every value.
pub func parse_headers(lines: list[string]): Headers {
    let headers = Headers();
    for (line in lines) {
        let colon = line.index_of(":");
        if (colon > 0) {
            headers.append(line.slice(0, colon).trim(), line.slice(colon + 1).trim());
        }
    }
    return headers;
}

# The value of a hexadecimal chunk size, or -1.
func hex_value(text: string): int {
    let digits = "0123456789abcdef";
    if (text.len() == 0 or text.len() > 8) {
        return -1;
    }
    var value = 0;
    for (ch in text.toLowerCase()) {
        let d = digits.index_of(ch);
        if (d < 0) {
            return -1;
        }
        value = value * 16 + d;
    }
    return value;
}

## A `Transfer-Encoding: chunked` body put back together: each chunk is a
## hexadecimal size line (extensions after `;` ignored), the bytes, CR LF;
## a size of 0 ends it (trailer fields are dropped).
pub func dechunk(body: bytes): Result[bytes, string] {
    var out: list[int] = [];
    var at = 0;
    while (true) {
        # The size line runs to the next LF.
        var eol = at;
        while (eol < body.len() and body[eol] != 10) {
            eol += 1;
        }
        if (eol >= body.len()) {
            return Err("malformed chunked body");
        }
        var size_text = body.slice(at, eol).decode().trim();
        let semi = size_text.index_of(";");
        if (semi >= 0) {
            size_text = size_text.slice(0, semi).trim();
        }
        let size = hex_value(size_text);
        if (size < 0) {
            return Err("malformed chunked body");
        }
        if (size == 0) {
            return Ok(bytesFromInts(out));
        }
        let start = eol + 1;
        if (start + size > body.len()) {
            return Err("truncated chunked body");
        }
        for (k in start..(start + size)) {
            out.push(body[k]);
        }
        # Skip the CR LF after the chunk's bytes.
        at = start + size;
        if (at < body.len() and body[at] == 13) {
            at += 1;
        }
        if (at < body.len() and body[at] == 10) {
            at += 1;
        }
    }
    return Ok(bytesFromInts(out));
}

## A whole raw reply as an HttpReply. `with_body` is false for a reply to
## HEAD, which has none whatever its headers say; so are 1xx, 204 and 304
## replies.
pub func parse_reply(raw: bytes, with_body: bool): Result[HttpReply, string] {
    if (raw.len() == 0) {
        return Err("empty reply");
    }
    let end = header_end(raw);
    if (end < 0) {
        return Err("malformed reply");
    }
    let lines = raw.slice(0, end).decode().replace("\r", "").split("\n");
    let (code, phrase) = parse_status_line(lines[0])?;
    let headers = parse_headers(lines.slice(1));
    let status = HttpStatus(code);
    if (status.reason == "Unknown" and phrase.len() > 0) {
        safe { status.reason = phrase; }
    }

    var body = raw.slice(end, raw.len());
    let bodiless = !with_body or status.isInformational() or code == 204 or code == 304;
    if (bodiless) {
        body = b"";
    } else if ((headers.get("Transfer-Encoding") ?? "").toLowerCase().contains("chunked")) {
        body = dechunk(body)?;
    } else {
        let declared = (headers.get("Content-Length") ?? "").trim();
        if (declared.len() > 0 and declared.len() < 10) {
            let n = declared.toInt();
            if (n >= 0 and n < body.len()) {
                body = body.slice(0, n);
            }
        }
    }
    return Ok(HttpReply(status, headers, body.decode()));
}
