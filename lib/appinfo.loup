@mode(host.dual)

# linkcheck's name, version, exit statuses and the limits it works within.
#
# Runtime: host.dual, but only ever interpreted here, by Stage0:
# bin/linkcheck.lpscr imports it under `loup-bootstrap run --allow-net`, and
# the unit tests through other lib/ modules under `loup-bootstrap test`.
# Nothing in this project compiles it.

pub const APP_NAME: string = "linkcheck";
pub const APP_VERSION: string = "0.1.0";
pub const USER_AGENT: string = "loup-cmd-linkcheck/0.1.0";

pub const EXIT_OK: int = 0;
pub const EXIT_BROKEN: int = 1;
pub const EXIT_USAGE: int = 2;

pub const DEFAULT_CONCURRENCY: int = 4;
pub const MAX_CONCURRENCY: int = 64;

# Redirects followed before a link counts as broken.
pub const MAX_REDIRECTS: int = 5;

# Bytes of a response that are read; the rest is not needed to find links
# (a page that size is far beyond what a crawler should parse anyway).
pub const MAX_RESPONSE_BYTES: int = 8_388_608;
