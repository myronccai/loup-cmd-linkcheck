@mode(host.dual)

# linkcheck's --help and --version text.
#
# Runtime: host.dual, but only ever interpreted here, by Stage0:
# bin/linkcheck.lpscr imports it under `loup-bootstrap run --allow-net` and
# tests/args_test.lpscr under `loup-bootstrap test`. Nothing in this project
# compiles it.

from .appinfo import (APP_NAME, APP_VERSION, DEFAULT_CONCURRENCY, MAX_CONCURRENCY, MAX_REDIRECTS);

pub func usage(): string {
    return [
        i"usage: {$ APP_NAME $} [OPTION]... URL",
        "Check every link of the web site at URL: read each of its pages (same",
        "scheme, host and port as URL) that can be reached from URL, check every",
        "link and image on them, and report the broken links with the pages that",
        "refer to them.",
        "",
        "  -d, --max-depth N      read pages at most N links away from URL (default:",
        "                         no limit); links on the last pages are still checked",
        i"  -c, --concurrency N    run up to N checks at a time (default {$ DEFAULT_CONCURRENCY $}, at most {$ MAX_CONCURRENCY $})",
        "  -e, --external         also check links to other sites (HEAD requests)",
        "  -x, --exclude PREFIX   skip links that start with PREFIX (repeatable)",
        "  -o, --html FILE        also write the report as an HTML page to FILE",
        "  -q, --quiet            print only the broken links",
        "  -v, --verbose          print each link on standard error as it is checked",
        "  -h, --help             display this help and exit",
        "  -V, --version          output version information and exit",
        "",
        i"Redirects are followed (at most {$ MAX_REDIRECTS $}). Only http:// is supported: https://",
        "links are counted as skipped. mailto:, tel:, javascript: and data: links",
        "are ignored.",
        "",
        "Runs under Stage0 with the network granted:",
        "  loup-bootstrap run --allow-net bin/linkcheck.lpscr -- [OPTION]... URL",
        "",
        "Exit status is 0 if no link is broken, 1 if some are, and 2 on a usage",
        "error or a URL that cannot be checked.",
    ].join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
